# Local development — copy to `.env`
# For production deploy, use `.env.production.example` instead.

# JWT authentication (required when NODE_ENV=production)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# PostgreSQL — optional locally (falls back to db.json without DATABASE_URL)
DATABASE_URL="postgresql://skillfort:skillfort_dev@localhost:5432/skillfort_lms"

# Set to true to require DATABASE_URL even in development (optional)
# REQUIRE_DATABASE_URL="true"

# Public URL of your deployed app (login links, certificate verify, payment callbacks)
APP_URL="http://localhost:3000"

# Split deploy: frontend origin allowed to call the API (comma-separated). Defaults to APP_URL.
# CORS_ORIGINS="https://your-frontend.vercel.app"

# Split deploy: set on Vercel (frontend) so API calls go to your backend host
# VITE_API_URL="https://your-backend.onrender.com"

# `npm run start` sets NODE_ENV=production automatically

# GEMINI_API_KEY (optional — for future Gemini AI features; not yet implemented)
GEMINI_API_KEY="your-gemini-api-key-here"

# Razorpay live payments (optional — without this, checkout uses simulator mode)
# RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Optional — Cloudinary for persistent uploads (recommended on Render/Vercel split deploy)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# VIMEO INTEGRATIONS (optional — embed player works without these)
VIMEO_ACCESS_TOKEN="your-vimeo-access-token"
VITE_VIMEO_CLIENT_ID="your-vimeo-client-id"

# SECURE CLOUD-HOSTED FIREBASE INTEGRATION (OPTIONAL)
# Fill these out to connect your own secure Firebase Cloud Database
# Obtain these from: Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
